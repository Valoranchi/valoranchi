{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AgentMastery",
  "definitions": {
    "AgentMastery": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "agentName": {
          "type": "string"
        },
        "agentIcon": {
          "$ref": "#/definitions/Image"
        },
        "longLevel": {
          "type": "number"
        },
        "shortLevel": {
          "type": "number"
        },
        "points": {
          "type": "number"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trackId": {
                "type": "string"
              },
              "level": {
                "type": "number"
              }
            },
            "required": ["trackId", "level"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "agentId",
        "agentName",
        "agentIcon",
        "longLevel",
        "shortLevel",
        "points",
        "tracks"
      ],
      "additionalProperties": false
    },
    "Image": {
      "type": ["string", "null"]
    }
  }
}
