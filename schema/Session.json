{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Session",
  "definitions": {
    "Session": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string"
        },
        "matches": {
          "type": "number"
        },
        "wins": {
          "type": "number"
        },
        "losses": {
          "type": "number"
        },
        "draws": {
          "type": "number"
        },
        "rrNet": {
          "type": "number"
        },
        "rrPerGame": {
          "type": "number"
        },
        "streak": {
          "$ref": "#/definitions/RatingStreak"
        },
        "rankStart": {
          "anyOf": [
            {
              "$ref": "#/definitions/Rank"
            },
            {
              "type": "null"
            }
          ]
        },
        "rankNow": {
          "anyOf": [
            {
              "$ref": "#/definitions/Rank"
            },
            {
              "type": "null"
            }
          ]
        },
        "bestMatch": {
          "anyOf": [
            {
              "$ref": "#/definitions/SessionMatchAcs"
            },
            {
              "type": "null"
            }
          ]
        },
        "worstMatch": {
          "anyOf": [
            {
              "$ref": "#/definitions/SessionMatchAcs"
            },
            {
              "type": "null"
            }
          ]
        },
        "tilt": {
          "type": "boolean"
        }
      },
      "required": [
        "since",
        "matches",
        "wins",
        "losses",
        "draws",
        "rrNet",
        "rrPerGame",
        "streak",
        "rankStart",
        "rankNow",
        "bestMatch",
        "worstMatch",
        "tilt"
      ],
      "additionalProperties": false
    },
    "RatingStreak": {
      "type": "object",
      "properties": {
        "kind": {
          "type": ["string", "null"],
          "enum": ["win", "loss", null]
        },
        "length": {
          "type": "number"
        }
      },
      "required": ["kind", "length"],
      "additionalProperties": false
    },
    "Rank": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "division": {
          "type": ["string", "null"]
        },
        "icon": {
          "$ref": "#/definitions/Image"
        },
        "rating": {
          "type": ["number", "null"]
        }
      },
      "required": ["tier", "name", "division", "icon", "rating"],
      "additionalProperties": false
    },
    "Image": {
      "type": ["string", "null"]
    },
    "SessionMatchAcs": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "matchId": {
          "type": "string"
        },
        "acs": {
          "type": "number"
        },
        "map": {
          "type": ["string", "null"]
        },
        "agent": {
          "type": ["string", "null"]
        }
      },
      "required": ["id", "matchId", "acs", "map", "agent"],
      "additionalProperties": false
    }
  }
}
