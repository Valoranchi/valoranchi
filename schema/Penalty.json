{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Penalty",
  "definitions": {
    "Penalty": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "issuedAt": {
          "type": ["string", "null"]
        },
        "matchId": {
          "type": ["string", "null"]
        },
        "gamesRemaining": {
          "type": ["number", "null"]
        },
        "queueIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warning": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "tier": {
                  "type": "number"
                }
              },
              "required": ["type", "tier"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "restriction": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": ["type", "reason"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "reason",
        "expiresAt",
        "issuedAt",
        "matchId",
        "gamesRemaining",
        "queueIds",
        "warning",
        "restriction",
        "effects"
      ],
      "additionalProperties": false
    }
  }
}
